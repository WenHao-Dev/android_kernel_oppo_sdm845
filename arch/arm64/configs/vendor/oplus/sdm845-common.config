# Auto local version
CONFIG_LOCALVERSION_AUTO=y

# Crypto
CONFIG_CRYPTO_LZ4=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Filesystems
CONFIG_EXFAT_FS=y

# Haptics
# CONFIG_INPUT_HBTP_INPUT is not set

# OPPO modules
CONFIG_OPPO_COMMON_SOFT=y
CONFIG_OPPO_DEVICE_INFO=y
CONFIG_OPLUS_FEATURE_PROJECTINFO=y
CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_RD_LZ4=y
